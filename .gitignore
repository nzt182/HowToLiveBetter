.DS_Store

# Worker 本地依赖、开发状态与密钥（示例配置保留）。
worker/node_modules/
worker/.wrangler/
worker/.dev.vars
worker/.dev.vars.*
!worker/.dev.vars.example
worker/.env
worker/.env.*

# Pages 采集入口的本地状态、构建产物与密钥。
collector-pages/.wrangler/
collector-pages/.dev.vars
collector-pages/.dev.vars.*
collector-pages/.env
collector-pages/.env.*
collector-pages/.build/
