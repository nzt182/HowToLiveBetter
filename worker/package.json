{
  "name": "how-to-live-better-visitor-log",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev --local",
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/admin.js",
    "db:local": "wrangler d1 migrations apply visitor_logs --local",
    "db:remote": "wrangler d1 migrations apply visitor_logs --remote",
    "deploy": "node scripts/check-deploy.js && wrangler deploy"
  },
  "devDependencies": { "wrangler": "4.151.0" }
}
