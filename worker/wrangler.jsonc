{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "how-to-live-better-visitor-log",
  "main": "src/index.js",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_SITE_URL": "https://nzt182.github.io/HowToLiveBetter/",
    "ALLOWED_ORIGINS": "https://nzt182.github.io",
    "RETENTION_DAYS": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visitor_logs",
      "database_id": "acb2683b-51bc-408b-8c0d-53a557a9272e",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 19 * * *"] }
}
